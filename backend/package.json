{
  "name": "empresa-radar-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend do Radar de Empresas: descoberta e verificação real de URLs e CNPJs por nicho.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
